# EAS 빌드 아카이브(LIFE-578) — 레포 루트가 git 루트라 기본은 모노레포 전체(704 MB)를 올린다. 모바일 앱 빌드에는 mobile/ 만 필요하다.
# .easignore 가 있으면 .gitignore 는 쓰이지 않으므로 mobile/.gitignore 의 산출물도 여기서 뺀다.
/*
!/mobile
# 모바일 버전 문자열 원천(LIFE-599 Q3) — mobile/app.config.ts 가 app/package.json 의 version 을 읽는다. app/ 은 이 파일과 아래 고지 훅 입력만 넣는다
!/app
/app/*
!/app/package.json
# APK 제3자 고지 훅(LIFE-729 — mobile/package.json eas-build-post-install → mobile/scripts/build-notices.mjs)이 아카이브 안에서 읽는 공용 lib·SPDX 원문.
# 빼면 훅이 import 실패로 죽어 EAS 빌드가 멈춘다 — notice-test.sh eas-archive 가 훅의 import 사슬과 같이 본다
# guard:eas-lib
!/app/scripts
/app/scripts/*
!/app/scripts/notices-lib.mjs
# guard:eas-spdx
!/app/scripts/spdx
/mobile/node_modules
/mobile/android
/mobile/ios
/mobile/.expo
/mobile/dist
/mobile/build-*.apk
/mobile/*.apk
/mobile/*.aab
/mobile/web-build
/mobile/.kotlin
/mobile/**/*.jks
/mobile/**/*.keystore
/mobile/**/*.p8
/mobile/**/*.p12
/mobile/**/*.key
/mobile/**/*.pem
/mobile/.env*.local
/mobile/.metro-health-check*
/mobile/**/.DS_Store
/mobile/*.tsbuildinfo
