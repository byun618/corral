+# Grok Build 1.0.40 asks for folder trust on startup for some directories. The confirmed trigger is
+# an `AGENTS.md` in the directory: LIFE-394 review r3 ran `grok inspect` on four throwaway repos and
+# only the two carrying `AGENTS.md` reported "Project trusted: no" (an empty repo and one with just
+# `.grok/settings.json {hooks:{}}` both reported "yes"). Which other project-local files trigger it
+# is not established — do not read this rule as "any project-local config".
+#
+# On that screen the OSC title stays the plain idle "grok", so without this rule osc_title_idle
+# (1100) wins and a waiting trust dialog is reported as idle. LIFE-394 live capture:
+#   Do you trust the contents of this directory?
+#   <cwd>
+#   Grok Build may run or modify contents in this directory, posing security risks.
+#   Yes, proceed                 y
+#   No, quit                     n
+#
+# Requiring the two option rows on consecutive lines is NOT enough on its own: review r3's negative
+# fixture `grok-quoted-dialog-idle` quotes exactly those three lines, consecutively, into an
+# otherwise ordinary screen and still matched. The live dialog is a full-screen takeover with no
+# composer and no footer hints, so the `not` gates below are what separate it from a quotation.
+#
+# Review r4 showed that testing for those hints as a bare substring is wrong in both directions: a
+# cwd containing `esc:cancel` silenced a real chooser, and one stale footer line left ABOVE the
+# dialog in the scrollback did the same. So each gate matches live chrome only as a **whole line**
+# — a footer whose `\u{2502}`-separated segments are hint tokens, or the bottom border of the composer
+# box — and only **below** the chooser's own option rows. That is exactly the arrangement a
+# quotation produces, and also the one a pane shows right after a human accepts trust: the footer
+# and composer come back under the trust text that stays in the scrollback feeding `whole_recent`.
 [[rules]]
+id = "trust_directory"
+state = "blocked"
+priority = 1250
+region = "whole_recent"
+visible_blocker = true
+all = [
+  { regex = ['(?s)Do\s+you\s+trust\s+the\s+contents\s+of\s+this\s+directory\?'] },
+  { regex = ['(?m)^\s*Yes,\s+proceed\s+y\s*\r?\n\s*No,\s+quit\s+n\s*$'] },
+]
+not = [
+  { regex = ['(?m)^[ \t]*No,[ \t]+quit[ \t]+n[ \t]*\r?$[\s\S]*?^(?:[^\r\n]*\x{2502})?[ \t]*(?i:Shift\+Tab:mode|Ctrl\+\.:shortcuts|Esc:cancel|Ctrl\+c:cancel|Ctrl\+o:yolo|Tab:scrollback|Shift\+x:dismiss|Esc:unselect)[ \t]*(?:\x{2502}[^\r\n]*)?\r?$'] },
+  { regex = ['(?m)^[ \t]*No,[ \t]+quit[ \t]+n[ \t]*\r?$[\s\S]*?^[ \t]*\x{2570}[\x{2500}\x{2501}\x{2550}-]{2,}[^\r\n]*\x{256f}[ \t]*\r?$'] },
+]
+
+[[rules]]
