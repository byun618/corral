+      { regex = ['(?m)^[ \t]*(?:[\x{203a}\x{276f}\x{258c}>][ \t]+)?1\.[ \t]+Trust[ \t]+and[ \t]+continue[ \t]*\r?\n[ \t]*(?:[\x{203a}\x{276f}\x{258c}>][ \t]+)?2\.[ \t]+Back[ \t]+to[ \t]+Agent[ \t]+Command[ \t]+Center[ \t]*\r?$'] },
+    ], not = [
+      { regex = ['(?m)^[ \t]*(?:[\x{203a}\x{276f}\x{258c}>][ \t]+)?2\.[ \t]+Back[ \t]+to[ \t]+Agent[ \t]+Command[ \t]+Center[ \t]*\r?$[\s\S]*?^[ \t]*[\x{203a}\x{276f}\x{258c}>][ \t]+(?i:Ask Codex to do anything)[ \t]*\r?$'] },
+    ] },
 ]
 
