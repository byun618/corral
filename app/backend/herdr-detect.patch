+#[test]
+fn codex_trust_directory_requires_live_chooser() {
+    // Positive: every captured live chooser stays blocked — including the one whose detection text
+    // starts with the shell line that launched codex, and the one whose cwd happens to contain the
+    // composer placeholder that the `not` gate looks for (review r4, D22).
+    for (label, screen) in [
+        ("plain", CODEX_TRUST_PLAIN),
+        ("worktree", CODEX_TRUST_WORKTREE),
+        ("r2-worktree", CODEX_TRUST_R2_WORKTREE),
+        ("shell-prefix", CODEX_TRUST_SHELL_PREFIX),
+        ("cwd-marker", CODEX_TRUST_CWD_MARKER),
+    ] {
+        let result = osc_explain(Agent::Codex, screen, "repo", "");
+        assert_eq!(result.state, AgentState::Blocked, "{label} must stay blocked");
+        assert_eq!(
+            result.matched_rule.as_ref().map(|rule| rule.id.as_str()),
+            Some("trust_directory"),
+            "{label} must match trust_directory"
+        );
+        assert!(result.visible_blocker, "{label} must be a visible blocker");
+    }
+
+    // Negative: an ordinary composer screen, the same screen while the title spins, and a
+    // multi-line quotation of the header and question must not become blockers.
+    for (label, screen, title) in [
+        ("composer-idle", CODEX_COMPOSER_IDLE, "repo"),
+        ("composer-working", CODEX_COMPOSER_WORKING, "\u{2827} Working"),
+        ("multiline-quote", CODEX_MULTILINE_QUOTE, "repo"),
+    ] {
+        let result = osc_explain(Agent::Codex, screen, title, "");
+        assert_ne!(result.state, AgentState::Blocked, "{label} must not be blocked");
+        assert!(!result.visible_blocker, "{label} must not be a visible blocker");
+    }
+}
