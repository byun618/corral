+# LIFE-780: a named session (`/rename`, `--name`, backgrounding) draws `─── name ─` under the dialog,
+# so `after_last_horizontal_rule` sees an empty region and live_blocked_form goes silent.
+# Based on upstream live_blocked_form_named_session (herdr #5192, #4573), with the hint slots left open:
+# `n to add notes` and `ctrl+g to edit in VS Code` (Claude Code 2.1.296 live captures) and
+# `Tab to switch questions` (#5741) are not an enumerable set. `Enter to …` and `Esc to cancel` must still
+# bind to one footer, wrapped between words or not. A hint may take four rows: `ctrl+g to edit in VS Code`,
+# the longest seen, needs three at a width of 10. Only the name line, then a counted task panel with marked
+# rows, one activity row indented under a `◼` row, and optional pending overflow (#4573 capture), may follow
+# it. Anything newer ends the match. The name line may be an untitled rule (#4824), so a draft holding the
+# whole footer reads as blocked when no status row sits under the box. That refuses input; it never adds any.
+# Spaces only: the screen grid holds no tabs, and a matcher may not pass 512 characters.
 [[rules]]
+id = "live_blocked_form_named_session"
+state = "blocked"
+priority = 980
+region = "whole_recent"
+visible_blocker = true
+regex = ['(?i)(?:^|\n) *enter(?: +| *\n *)to(?: +| *\n *)(?:confirm|select)(?:(?: +| *\n *)·(?: +| *\n *)[^\n·]+(?:\n *[^\n·─❯]+){0,3})*?(?: +| *\n *)·(?: +| *\n *)esc(?: +| *\n *)to(?: +| *\n *)cancel *\n(?: *\n)* *─{3,}[^\n]*(?:\n(?: *\n)* +\d+ tasks? \(\d+ done, (?:\d+ in progress, )?\d+ open\)(?:\n {1,2}◼ +[^\n]+\n {3,}[^\s❯─][^\n]*|\n +[◻◼✔] +[^\n]+)+(?:\n +… +\+\d+ +pending)?)?(?:\n *)*\z']
+
+# LIFE-780: the same name line turns the AskUserQuestion review screen into a "prompt box" whose
+# `❯ 1. Submit answers` wins as live_prompt_box (950). This has to sit above that rule. It wants a titled
+# name line because a plain rule closes a real prompt box, whose draft may hold the same two lines.
+[[rules]]
+id = "live_blocked_review_named_session"
+state = "blocked"
+priority = 980
+region = "whole_recent"
+visible_blocker = true
+regex = ['(?:^|\n)[ \t]*(?:❯[ \t]*)?1\.[ \t]+Submit answers[ \t]*\n[ \t]*(?:❯[ \t]*)?2\.[ \t]+Cancel[ \t]*\n(?:[ \t]*\n)*[ \t]*─{3,}[ \t]+\S[^\n]*─[ \t]*(?:\n[ \t]*)*\z']
+
+[[rules]]
 id = "dynamic_workflow_prompt"
 state = "blocked"
 priority = 980
