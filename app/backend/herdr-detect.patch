+#[test]
+fn grok_trust_directory_requires_live_chooser() {
+    // Positive: the live dialog outranks the plain idle OSC title it is drawn under. The two
+    // review r4 counter-examples — a cwd carrying a hint token, and a stale footer line left above
+    // the dialog — stay blocked because the `not` gates only look for whole chrome lines below the
+    // chooser (D22).
+    for (label, screen) in [
+        ("project", GROK_TRUST_PROJECT),
+        ("cwd-marker", GROK_TRUST_CWD_MARKER),
+        ("old-footer-above", GROK_TRUST_OLD_FOOTER),
+    ] {
+        let result = osc_explain(Agent::Grok, screen, "grok", "4;0;0");
+        assert_eq!(result.state, AgentState::Blocked, "{label} must stay blocked");
+        assert_eq!(
+            result.matched_rule.as_ref().map(|rule| rule.id.as_str()),
+            Some("trust_directory"),
+            "{label} must match trust_directory"
+        );
+        assert!(result.visible_blocker, "{label} must be a visible blocker");
+    }
+
+    // Negative: the ordinary screen, and the same screen with the dialog text quoted into it, in
+    // both the idle and the working OSC states the review exercised. The quoted screen is also the
+    // arrangement a pane shows after a human accepts trust, so this case doubles as the guard
+    // against re-reporting `blocked` from scrollback (LIFE-394 F5-grok).
+    for (label, screen) in [
+        ("idle-default", GROK_IDLE_DEFAULT),
+        ("quoted-dialog", GROK_QUOTED_DIALOG),
+    ] {
+        for (state, title, progress) in [
+            ("idle", "grok", "4;0;0"),
+            ("working", "\u{28E7} Working - grok", "4;1;-1"),
+        ] {
+            let result = osc_explain(Agent::Grok, screen, title, progress);
+            assert_ne!(
+                result.state,
+                AgentState::Blocked,
+                "{label} under {state} must not be blocked"
+            );
+            assert!(
+                !result.visible_blocker,
+                "{label} under {state} must not be a visible blocker"
+            );
+        }
+    }
+}
