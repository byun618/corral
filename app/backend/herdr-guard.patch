+        // Launch, then one whole turn. The first Idle is the launch settling, which herdr does not
+        // count as a completion (`actions.rs` 1873~1875 `suppress_completion`), so it reports `idle`
+        // and the managed agent becomes Active. The Idle that ends the *turn* is a completion
+        // transition on a pane nobody is watching, and that is the `done` this test is about.
+        observe(&mut app, pane, &terminal, AgentState::Unknown);
+        observe(&mut app, pane, &terminal, AgentState::Idle);
