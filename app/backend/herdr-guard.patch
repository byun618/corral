+use super::App;
+use crate::api::schema::{AgentStatus, CorralTerminalParams, Method, Request, ResponseResult};
+use super::responses::{encode_error, encode_error_body, encode_success};
+
+fn epoch() -> &'static str {
+    static EPOCH: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+    EPOCH.get_or_init(|| {
+        use std::io::Read;
+        let mut bytes = [0u8; 32];
+        std::fs::File::open("/dev/urandom").unwrap().read_exact(&mut bytes).unwrap();
+        bytes.iter().map(|byte| format!("{byte:02x}")).collect()
+    })
+}
+impl App {
+    pub(super) fn handle_corral_terminal(&mut self, id: String, params: CorralTerminalParams) -> String {
+        let Some(mut operation) = params.operation else {
+            return serde_json::json!({"id": id, "result": {"epoch": epoch(), "guard_version": 1,
+                "raw_capacity": 1048576, "conditional_process": false, "agent_ops": 1}}).to_string();
+        };
+        if params.epoch != epoch() { return encode_error(id, "stale_backend", "backend generation changed"); }
+        let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis();
+        if now >= u128::from(params.deadline_ms) { return encode_error(id, "deadline_exceeded", "no effect started"); }
+        operation["id"] = serde_json::Value::String(id.clone());
+        let Ok(request) = serde_json::from_value::<Request>(operation) else {
+            return encode_error(id, "invalid_request", "invalid guarded operation");
+        };
+        let target = match &request.method {
+            Method::PaneSendText(p) => Some(p.pane_id.as_str()),
+            Method::PaneClose(p) => Some(p.pane_id.as_str()),
+            Method::PaneRead(p) => Some(p.pane_id.as_str()),
+            Method::PaneProcessInfo(p) => p.pane_id.as_deref(),
+            Method::AgentStart(p) => Some(p.pane_id.as_str()),
+            Method::AgentGet(t) => Some(t.target.as_str()),
+            Method::AgentPrompt(p) => Some(p.target.as_str()),
+            Method::TabRename(_) => params.pane_id.as_deref(),
+            // Read-only, target-less arms. server.agent_manifests is here so corral can check which
+            // detect manifest is actually active without leaving the guard envelope or widening the
+            // app-side method allowlist; it aims at no pane, so there is no generation to compare.
+            Method::SessionSnapshot(_) | Method::WorkspaceCreate(_) | Method::TabCreate(_)
+            | Method::ServerAgentManifests(_) => None,
+            _ => return encode_error(id, "unsupported", "operation is outside terminal guard protocol"),
+        };
+        if let Some(target) = target {
+            if params.pane_id.as_deref() != Some(target) { return encode_error(id, "invalid_request", "target mismatch"); }
+            let Some((ws, pane)) = self.parse_pane_id(target) else { return encode_error(id, "stale_terminal", "pane disappeared"); };
+            let actual = self.state.terminal_id_for_pane(ws, pane).and_then(|value| self.lookup_runtime_sender(ws, pane).map(|runtime| format!("{value}.{}", runtime.corral_generation())));
+            if actual.is_none() || actual != params.terminal_id { return encode_error(id, "stale_terminal", "PTY generation changed"); }
+            if let Method::TabRename(p) = &request.method {
+                let Some((tab_ws, tab_idx)) = self.parse_tab_id(&p.tab_id) else { return encode_error(id, "stale_terminal", "tab disappeared"); };
+                if tab_ws != ws || !self.state.workspaces[ws].tabs[tab_idx].panes.contains_key(&pane) {
+                    return encode_error(id, "stale_terminal", "pane moved to another tab");
+                }
+            }
+        } else if matches!(&request.method, Method::TabRename(_)) {
+            return encode_error(id, "invalid_request", "rename needs terminal guard");
+        }
+        // agent.prompt never reaches the app dispatch table: api.rs rejects it and the api server
+        // defers it before dispatch. Check the ready predicate and queue the submission here, in
+        // the same guarded turn — compare-and-submit against the state_change_seq corral observed,
+        // so a transition after that observation cannot be submitted into. The completion receiver
+        // is dropped: queueing is not cancelled by the drop, and delivery is proven from the
+        // provider session record, not from herdr.
+        if matches!(&request.method, Method::AgentPrompt(_)) {
+            let prompt_id = request.id.clone();
+            let Method::AgentPrompt(prompt) = request.method else { unreachable!() };
+            let Some(expected_seq) = params.expected_state_change_seq else {
+                return encode_error(prompt_id, "invalid_request", "agent.prompt requires expected_state_change_seq");
+            };
+            self.reconcile_managed_agent_target(&prompt.target);
+            let observed = match self.agent_info_for_target(&prompt.target) {
+                Ok(agent) => agent,
+                Err(err) => return encode_error_body(prompt_id, self.agent_target_error_body(err)),
+            };
+            if observed.agent_status != AgentStatus::Idle || !observed.interactive_ready
+                || observed.launch_pending || observed.state_change_seq != expected_seq {
+                let code = if observed.agent_status == AgentStatus::Blocked { "agent_blocked" } else { "agent_not_ready" };
+                let message = format!("agent is not the observed ready state (expected state_change_seq {expected_seq}, observed {})", observed.state_change_seq);
+                return serde_json::json!({"id": prompt_id,
+                    "error": {"code": code, "message": message, "observed": observed}}).to_string();
+            }
+            return match self.queue_agent_prompt(prompt_id, prompt) {
+                Ok((id, agent, _completion)) => encode_success(id, ResponseResult::AgentPrompted { agent }),
+                Err(response) => response,
+            };
+        }
+        // No await, internal-event drain, or second queue between guard and effect.
+        let snapshot = matches!(&request.method, Method::SessionSnapshot(_));
+        let response = self.handle_api_request_after_internal_events_drained(request);
+        if !snapshot { return response; }
+        let mut value: serde_json::Value = serde_json::from_str(&response).unwrap();
+        if let Some(panes) = value["result"]["snapshot"]["panes"].as_array_mut() {
+            for pane in panes {
+                let generation = pane["pane_id"].as_str().and_then(|id| self.parse_pane_id(id))
+                    .and_then(|(ws, pane)| self.lookup_runtime_sender(ws, pane))
+                    .map(|runtime| runtime.corral_generation().to_string());
+                pane["corral_pty_generation"] = serde_json::json!(generation);
+            }
+        }
+        value.to_string()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[tokio::test]
+    async fn corral_terminal_rejects_old_generation_after_real_pty_respawn() {
+        let (_tx, rx) = tokio::sync::mpsc::unbounded_channel();
+        let mut app = App::new(&crate::config::Config::default(), crate::app::AppPolicy::TEST, None, rx, crate::api::EventHub::default());
+        app.state.default_shell = "/bin/sh".into(); app.state.shell_mode = crate::config::ShellModeConfig::NonLogin;
+        let root = std::env::temp_dir().join(format!("l393-codex-rust-{}", std::process::id()));
+        std::fs::create_dir_all(&root).unwrap();
+        let req: Request = serde_json::from_value(serde_json::json!({"id":"create", "method":"workspace.create", "params":{"cwd":root,"focus":false}})).unwrap();
+        let response: serde_json::Value = serde_json::from_str(&app.handle_api_request_after_internal_events_drained(req)).unwrap();
+        assert!(response.get("error").is_none(), "{response}");
+        let pane_name = response["result"]["root_pane"]["pane_id"].as_str().unwrap().to_string();
+        let (ws, pane) = app.parse_pane_id(&pane_name).unwrap();
+        let terminal = app.state.terminal_id_for_pane(ws, pane).unwrap();
+        let old_runtime = app.terminal_runtimes.remove(&terminal).unwrap();
+        let old_generation = old_runtime.corral_generation();
+        old_runtime.shutdown();
+        assert!(app.respawn_shell_for_launch_pane(pane, false));
+        let new_generation = app.lookup_runtime_sender(ws, pane).unwrap().corral_generation();
+        assert_ne!(old_generation, new_generation);
+        for (method, text) in [("pane.send_text", "WRONG\r"), ("pane.send_text", "\u{3}"), ("pane.close", "")] {
+            let operation = if method == "pane.close" { serde_json::json!({"method":method,"params":{"pane_id":pane_name}}) }
+                else { serde_json::json!({"method":method,"params":{"pane_id":pane_name,"text":text}}) };
+            let response: serde_json::Value = serde_json::from_str(&app.handle_corral_terminal("guard".into(), CorralTerminalParams {
+                epoch: epoch().into(), deadline_ms: u64::MAX, pane_id: Some(pane_name.clone()), terminal_id: Some(format!("{terminal}.{old_generation}")), operation: Some(operation), expected_state_change_seq: None,
+            })).unwrap();
+            assert_eq!(response["error"]["code"], "stale_terminal");
+            assert_eq!(app.lookup_runtime_sender(ws, pane).unwrap().corral_generation(), new_generation);
+        }
+        let manifests: serde_json::Value = serde_json::from_str(&app.handle_corral_terminal("guard".into(), CorralTerminalParams {
+            epoch: epoch().into(), deadline_ms: u64::MAX, pane_id: None, terminal_id: None,
+            operation: Some(serde_json::json!({"method":"server.agent_manifests","params":{}})), expected_state_change_seq: None,
+        })).unwrap();
+        assert!(manifests.get("error").is_none(), "{manifests}");
+        assert!(manifests["result"]["manifests"].as_array().is_some_and(|list| !list.is_empty()), "{manifests}");
+        println!("guarded server.agent_manifests: {}", manifests["result"]["manifests"]);
+        tokio::time::sleep(std::time::Duration::from_millis(100)).await;
+        let (raw, _, _) = app.lookup_runtime_sender(ws, pane).unwrap().corral_raw_snapshot();
+        use base64::Engine;
+        let output = base64::engine::general_purpose::STANDARD.decode(raw).unwrap();
+        assert!(!String::from_utf8_lossy(&output).contains("WRONG"));
+        println!("same terminal={terminal}, old PTY generation={old_generation}, new={new_generation}; send/interrupt/close rejected; replacement alive; output={:?}", String::from_utf8_lossy(&output));
+        for (_, runtime) in app.terminal_runtimes.drain() { runtime.shutdown(); }
+        std::fs::remove_dir_all(root).unwrap();
+    }
+}
