+    /// R11: `done` is `AgentState::Idle` that no focused active tab has *seen*
+    /// (`api_helpers.rs` 96~106), so every pane corral drives reports it once a turn finishes. The
+    /// guard has to take the next prompt in that state and still refuse Working, Blocked and a
+    /// stale `state_change_seq`. No provider is launched here: the managed agent is begun on the
+    /// terminal and the detect transitions are injected, which is how herdr's own state tests drive
+    /// this (`actions.rs` `idle_after_known_unknown_agent_in_background_marks_done`).
+    #[tokio::test]
+    async fn corral_terminal_accepts_a_done_pane_and_refuses_the_rest() {
+        use crate::detect::{Agent, AgentState};
+        use crate::events::AppEvent;
+        use std::time::{Duration, Instant};
+        let (_tx, rx) = tokio::sync::mpsc::unbounded_channel();
+        let mut app = App::new(&crate::config::Config::default(), crate::app::AppPolicy::TEST, None, rx, crate::api::EventHub::default());
+        app.state.default_shell = "/bin/sh".into(); app.state.shell_mode = crate::config::ShellModeConfig::NonLogin;
+        let root = std::env::temp_dir().join(format!("l394-claude-done-{}", std::process::id()));
+        std::fs::create_dir_all(&root).unwrap();
+        let req: Request = serde_json::from_value(serde_json::json!({"id":"create", "method":"workspace.create", "params":{"cwd":root,"focus":false}})).unwrap();
+        let response: serde_json::Value = serde_json::from_str(&app.handle_api_request_after_internal_events_drained(req)).unwrap();
+        assert!(response.get("error").is_none(), "{response}");
+        let pane_name = response["result"]["root_pane"]["pane_id"].as_str().unwrap().to_string();
+        let (ws, pane) = app.parse_pane_id(&pane_name).unwrap();
+        let terminal = app.state.terminal_id_for_pane(ws, pane).unwrap();
+        // Nobody is looking at this pane: focus is explicitly false, so a finished turn is Done.
+        app.state.outer_terminal_focus = Some(false);
+        app.state.terminals.get_mut(&terminal).unwrap().begin_managed_agent(
+            "corral-done".into(), Agent::Claude, Instant::now(), Duration::ZERO, Duration::from_secs(300));
+        fn observe(app: &mut App, pane: crate::layout::PaneId, terminal: &crate::terminal::TerminalId, state: AgentState) {
+            app.state.handle_app_event(AppEvent::StateChanged { pane_id: pane, agent: Some(Agent::Claude), state,
+                visible_blocker: state == AgentState::Blocked, visible_working: state == AgentState::Working,
+                process_exited: false, observed_at: Instant::now() });
+            app.state.terminals.get_mut(terminal).unwrap().reconcile_managed_agent_at(Instant::now(), false);
+        }
+        // Launch, then one whole turn. The first Idle is the launch settling, which herdr does not
+        // count as a completion (`actions.rs` 1873~1875 `suppress_completion`), so it reports `idle`
+        // and the managed agent becomes Active. The Idle that ends the *turn* is a completion
+        // transition on a pane nobody is watching, and that is the `done` this test is about.
+        observe(&mut app, pane, &terminal, AgentState::Unknown);
+        observe(&mut app, pane, &terminal, AgentState::Idle);
+        let launched = app.agent_info(ws, pane).expect("agent info for the managed pane");
+        assert_eq!(launched.agent_status, AgentStatus::Idle, "{launched:?}");
+        assert!(launched.interactive_ready && !launched.launch_pending, "{launched:?}");
+        observe(&mut app, pane, &terminal, AgentState::Working);
+        observe(&mut app, pane, &terminal, AgentState::Idle);
+        let info = app.agent_info(ws, pane).expect("agent info for the managed pane");
+        assert_eq!(info.agent_status, AgentStatus::Done, "{info:?}");
+        assert!(info.interactive_ready && !info.launch_pending, "{info:?}");
+        let seq = info.state_change_seq;
+        let generation = app.lookup_runtime_sender(ws, pane).unwrap().corral_generation();
+        let target = format!("{terminal}.{generation}");
+        fn submit(app: &mut App, pane_name: &str, target: &str, expected: u64) -> serde_json::Value {
+            serde_json::from_str(&app.handle_corral_terminal("guard".into(), CorralTerminalParams {
+                epoch: epoch().into(), deadline_ms: u64::MAX, pane_id: Some(pane_name.to_string()), terminal_id: Some(target.to_string()),
+                operation: Some(serde_json::json!({"method":"agent.prompt","params":{"target":pane_name,"text":"second turn"}})),
+                expected_state_change_seq: Some(expected), expected_input_revision: None, min_input_idle_ms: None,
+            })).unwrap()
