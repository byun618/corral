+use super::App;
+use crate::api::schema::{AgentStatus, CorralTerminalParams, Method, Request, ResponseResult};
+use super::responses::{encode_error, encode_error_body, encode_success};
+
+fn epoch() -> &'static str {
+    static EPOCH: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+    EPOCH.get_or_init(|| {
+        use std::io::Read;
+        let mut bytes = [0u8; 32];
+        std::fs::File::open("/dev/urandom").unwrap().read_exact(&mut bytes).unwrap();
+        bytes.iter().map(|byte| format!("{byte:02x}")).collect()
+    })
+}
+impl App {
+    pub(super) fn handle_corral_terminal(&mut self, id: String, params: CorralTerminalParams) -> String {
+        let Some(mut operation) = params.operation else {
+            return serde_json::json!({"id": id, "result": {"epoch": epoch(), "guard_version": 1,
+                "raw_capacity": 1048576, "conditional_process": false, "agent_ops": 1, "unmanaged_prompt": 1}}).to_string();
+        };
+        if params.epoch != epoch() { return encode_error(id, "stale_backend", "backend generation changed"); }
+        let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis();
+        if now >= u128::from(params.deadline_ms) { return encode_error(id, "deadline_exceeded", "no effect started"); }
+        operation["id"] = serde_json::Value::String(id.clone());
+        let Ok(request) = serde_json::from_value::<Request>(operation) else {
+            return encode_error(id, "invalid_request", "invalid guarded operation");
+        };
+        let target = match &request.method {
+            Method::PaneSendText(p) => Some(p.pane_id.as_str()),
+            Method::PaneClose(p) => Some(p.pane_id.as_str()),
+            Method::PaneRead(p) => Some(p.pane_id.as_str()),
+            Method::PaneProcessInfo(p) => p.pane_id.as_deref(),
+            Method::AgentStart(p) => Some(p.pane_id.as_str()),
+            Method::AgentGet(t) => Some(t.target.as_str()),
+            // Read-only, and it carries the same AgentTarget as agent.get, so it gets the same
+            // identity check: params.pane_id must equal the target and the PTY generation must
+            // still match. LIFE-456 R2-F1 — without this arm the CLI's blocked reason is always
+            // `unknown`, because the only reason source (matched detect rule) lives behind
+            // agent.explain and the guard answered `unsupported`. Widening the allowlist by one
+            // read-only method does not change the envelope, so guard_version stays 1.
+            Method::AgentExplain(t) => Some(t.target.as_str()),
+            Method::AgentPrompt(p) => Some(p.target.as_str()),
+            Method::TabRename(_) => params.pane_id.as_deref(),
+            // Read-only, target-less arms. server.agent_manifests is here so corral can check which
+            // detect manifest is actually active without leaving the guard envelope or widening the
+            // app-side method allowlist; it aims at no pane, so there is no generation to compare.
+            Method::SessionSnapshot(_) | Method::WorkspaceCreate(_) | Method::TabCreate(_)
+            | Method::ServerAgentManifests(_) => None,
+            _ => return encode_error(id, "unsupported", "operation is outside terminal guard protocol"),
+        };
+        if let Some(target) = target {
+            if params.pane_id.as_deref() != Some(target) { return encode_error(id, "invalid_request", "target mismatch"); }
+            let Some((ws, pane)) = self.parse_pane_id(target) else { return encode_error(id, "stale_terminal", "pane disappeared"); };
+            let actual = self.state.terminal_id_for_pane(ws, pane).and_then(|value| self.lookup_runtime_sender(ws, pane).map(|runtime| format!("{value}.{}", runtime.corral_generation())));
+            if actual.is_none() || actual != params.terminal_id { return encode_error(id, "stale_terminal", "PTY generation changed"); }
+            if let Method::TabRename(p) = &request.method {
+                let Some((tab_ws, tab_idx)) = self.parse_tab_id(&p.tab_id) else { return encode_error(id, "stale_terminal", "tab disappeared"); };
+                if tab_ws != ws || !self.state.workspaces[ws].tabs[tab_idx].panes.contains_key(&pane) {
+                    return encode_error(id, "stale_terminal", "pane moved to another tab");
+                }
+            }
+        } else if matches!(&request.method, Method::TabRename(_)) {
+            return encode_error(id, "invalid_request", "rename needs terminal guard");
+        }
+        // agent.prompt never reaches the app dispatch table: api.rs rejects it and the api server
+        // defers it before dispatch. Check the ready predicate and queue the submission here, in
+        // the same guarded turn — compare-and-submit against the state_change_seq corral observed,
+        // so a transition after that observation cannot be submitted into. The completion receiver
+        // is dropped: queueing is not cancelled by the drop, and delivery is proven from the
+        // provider session record, not from herdr.
+        if matches!(&request.method, Method::AgentPrompt(_)) {
+            let prompt_id = request.id.clone();
+            let Method::AgentPrompt(prompt) = request.method else { unreachable!() };
+            let Some(expected_seq) = params.expected_state_change_seq else {
+                return encode_error(prompt_id, "invalid_request", "agent.prompt requires expected_state_change_seq");
+            };
+            self.reconcile_managed_agent_target(&prompt.target);
+            let observed = match self.agent_info_for_target(&prompt.target) {
+                Ok(agent) => agent,
+                Err(err) => return encode_error_body(prompt_id, self.agent_target_error_body(err)),
+            };
+            // Idle and Done are one detect state (AgentState::Idle); api_helpers.rs splits them by
+            // whether the completion was seen, and on a completion transition seen is set to
+            // is_active_tab && outer_terminal_focus != Some(false) — GUI attention, not readiness.
+            // So a pane that is not the active tab, or whose window focus is explicitly false, is
+            // Done every finished turn; launch_pending and expected_state_change_seq still fence.
+            let unready = self.corral_prompt_unready(&prompt.target, params.unmanaged_agent.as_deref(), observed.interactive_ready);
+            if !matches!(observed.agent_status, AgentStatus::Idle | AgentStatus::Done) || unready.is_some()
+                || observed.launch_pending || observed.state_change_seq != expected_seq {
+                let code = if observed.agent_status == AgentStatus::Blocked { "agent_blocked" } else { "agent_not_ready" };
+                let message = format!("agent is not the observed ready state (expected state_change_seq {expected_seq}, observed {})", observed.state_change_seq);
+                let mut error = serde_json::json!({"code": code, "message": message, "observed": observed});
+                if params.unmanaged_agent.is_some() { error["unready"] = serde_json::json!(unready); }
+                return serde_json::json!({"id": prompt_id, "error": error}).to_string();
+            }
+            // LIFE-582 R1-A3/R2-A3: corral read the screen (no draft) in a pane.read that reported this input revision.
+            // A key, paste or raw send since then may be a draft the screen did not show, and it would merge with this
+            // prompt into one submission — refuse in this turn. Human input (attach clients, client-shell panes) is
+            // applied in the same server loop as this request, so nothing lands between this check and the queue.
+            if let Some(refused) = self.corral_input_fence(&prompt_id, &prompt.target, params.expected_input_revision, params.min_input_idle_ms) { return refused; }
+            return match self.queue_agent_prompt(prompt_id, prompt) {
+                Ok((id, agent, _completion)) => encode_success(id, ResponseResult::AgentPrompted { agent }),
+                Err(response) => response,
+            };
+        }
+        // LIFE-582: pane.send_text may carry the state_change_seq corral observed (a question still open, a
+        // turn still running). Compare it in this same turn and refuse on any transition, so a key meant
+        // for one screen never lands on the next one. Without the field the arm is unchanged.
+        if let (Method::PaneSendText(send), Some(expected_seq)) = (&request.method, params.expected_state_change_seq) {
+            self.reconcile_managed_agent_target(&send.pane_id);
+            let observed = match self.agent_info_for_target(&send.pane_id) {
+                Ok(agent) => agent,
+                Err(err) => return encode_error_body(id, self.agent_target_error_body(err)),
+            };
+            if observed.state_change_seq != expected_seq {
+                let message = format!("agent state changed (expected state_change_seq {expected_seq}, observed {})", observed.state_change_seq);
+                return serde_json::json!({"id": id, "error": {"code": "agent_state_changed", "message": message, "observed": observed}}).to_string();
+            }
+        }
+        // LIFE-582 R2-A1: pane.send_text may also carry the input revision corral last saw (the screen it read, or the
+        // revision this guard returned after corral's previous key). Any other input since then is `input_changed` and
+        // nothing is written — so a multi-key answer cannot interleave with a desktop key.
+        if let Method::PaneSendText(send) = &request.method {
+            if let Some(refused) = self.corral_input_fence(&id, &send.pane_id, params.expected_input_revision, params.min_input_idle_ms) { return refused; }
+        }
+        // No await, internal-event drain, or second queue between guard and effect.
+        let snapshot = matches!(&request.method, Method::SessionSnapshot(_));
+        let input_target = match &request.method {
+            Method::AgentGet(t) => Some((t.target.clone(), "agent")),
+            // LIFE-582 R2-A3: the screen and the input revision/quiet time (and the agent's state_change_seq) of the
+            // same turn — corral then knows the screen was captured after the input went quiet, and fences on it.
+            Method::PaneRead(p) => Some((p.pane_id.clone(), "read")),
+            // LIFE-582 R2-A1: the revision after this write, so corral's next key can fence on it.
+            Method::PaneSendText(p) if params.expected_input_revision.is_some() => Some((p.pane_id.clone(), "send")),
+            _ => None,
+        };
+        let response = self.handle_api_request_after_internal_events_drained(request);
+        // LIFE-582 R1-A3: agent.get also reports the pane's user-input revision and quiet time, read in this turn.
+        if let Some((target, slot)) = input_target {
+            let input = self.parse_pane_id(&target).and_then(|(ws, pane)| self.lookup_runtime_sender(ws, pane)).map(|runtime| runtime.corral_input_state());
+            let seq = if slot == "read" { self.agent_info_for_target(&target).ok().map(|agent| agent.state_change_seq) } else { None };
+            // LIFE-597: how long the agent state has held, so corral waits out the unmanaged settle instead of being refused.
+            let quiet = if slot == "agent" { self.corral_terminal_state(&target).map(|terminal| terminal.corral_agent_changed_at.map(|at| at.elapsed().as_millis() as u64)) } else { None };
+            let mut value: serde_json::Value = serde_json::from_str(&response).unwrap();
+            if value.get("error").is_some() { return response; }
+            if slot == "send" && !value["result"].is_object() { value["result"] = serde_json::json!({}); }
+            let place = match slot { "agent" => value["result"]["agent"].as_object_mut(), "read" => value["result"]["read"].as_object_mut(), _ => value["result"].as_object_mut() };
+            if let (Some((revision, idle_ms)), Some(place)) = (input, place) {
+                place.insert("corral_input_revision".into(), serde_json::json!(revision));
+                place.insert("corral_input_idle_ms".into(), serde_json::json!(idle_ms));
+                if let Some(seq) = seq { place.insert("corral_state_change_seq".into(), serde_json::json!(seq)); }
+                if let Some(quiet) = quiet { place.insert("corral_state_quiet_ms".into(), serde_json::json!(quiet)); }
+            }
+            return value.to_string();
+        }
+        if !snapshot { return response; }
+        let mut value: serde_json::Value = serde_json::from_str(&response).unwrap();
+        if let Some(panes) = value["result"]["snapshot"]["panes"].as_array_mut() {
+            for pane in panes {
+                let generation = pane["pane_id"].as_str().and_then(|id| self.parse_pane_id(id))
+                    .and_then(|(ws, pane)| self.lookup_runtime_sender(ws, pane))
+                    .map(|runtime| runtime.corral_generation().to_string());
+                pane["corral_pty_generation"] = serde_json::json!(generation);
+            }
+        }
+        value.to_string()
+    }
+    fn corral_terminal_state(&self, target: &str) -> Option<&crate::terminal::TerminalState> {
+        let (ws, pane) = self.parse_pane_id(target)?;
+        self.state.terminals.get(&self.state.terminal_id_for_pane(ws, pane)?)
+    }
+    /// The ready predicate's launch half — why the pane is not ready, or None. A managed pane (or a request without
+    /// `unmanaged_agent`) needs interactive_ready, as before. LIFE-597: a pane with no managed agent never gets it, so a
+    /// request that names the expected kind replaces the launch proof with what the managed launch itself checks — herdr
+    /// detects that kind (queue_agent_prompt then checks it is the foreground process) and the state has held for
+    /// AGENT_START_SETTLE_DELAY. A managed pane still Pending or Blocked is not unmanaged and stays refused.
+    fn corral_prompt_unready(&self, target: &str, unmanaged_agent: Option<&str>, interactive_ready: bool) -> Option<&'static str> {
+        let terminal = self.corral_terminal_state(target);
+        let Some((kind, terminal)) = unmanaged_agent.zip(terminal).filter(|(_, terminal)| terminal.managed_agent_kind().is_none()) else {
+            return (!interactive_ready).then_some("not_interactive_ready");
+        };
+        if terminal.effective_known_agent().map(crate::detect::agent_label) != Some(kind) { return Some("unmanaged_kind_mismatch"); }
+        if !terminal.corral_agent_changed_at.is_some_and(|at| at.elapsed() >= crate::app::AGENT_START_SETTLE_DELAY) { return Some("unmanaged_settling"); }
+        None
+    }
+    /// LIFE-582: refuse in this turn when the pane's user input moved since the revision corral saw (`input_changed`)
+    /// or moved less than `min_idle` ago (`input_recent`). Neither field — no fence (the CLI arms are unchanged).
+    fn corral_input_fence(&self, id: &str, target: &str, expected: Option<u64>, min_idle: Option<u64>) -> Option<String> {
+        if expected.is_none() && min_idle.is_none() { return None; }
+        let input = self.parse_pane_id(target).and_then(|(ws, pane)| self.lookup_runtime_sender(ws, pane)).map(|runtime| runtime.corral_input_state());
+        let Some((revision, idle_ms)) = input else { return Some(encode_error(id.to_string(), "stale_terminal", "pane disappeared")); };
+        let changed = expected.is_some_and(|expected| expected != revision);
+        if !changed && !min_idle.is_some_and(|min| idle_ms < min) { return None; }
+        let code = if changed { "input_changed" } else { "input_recent" };
+        Some(serde_json::json!({"id": id, "error": {"code": code, "message": "pane input moved since corral observed it",
+            "observed_input": {"revision": revision, "idle_ms": idle_ms}}}).to_string())
+    }
+}
