+use super::App;
+use crate::api::schema::{CorralTerminalParams, Method, Request};
+use super::responses::encode_error;
+
+fn epoch() -> &'static str {
+    static EPOCH: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+    EPOCH.get_or_init(|| {
+        use std::io::Read;
+        let mut bytes = [0u8; 32];
+        std::fs::File::open("/dev/urandom").unwrap().read_exact(&mut bytes).unwrap();
+        bytes.iter().map(|byte| format!("{byte:02x}")).collect()
+    })
+}
+impl App {
+    pub(super) fn handle_corral_terminal(&mut self, id: String, params: CorralTerminalParams) -> String {
+        let Some(mut operation) = params.operation else {
+            return serde_json::json!({"id": id, "result": {"epoch": epoch(), "guard_version": 1,
+                "raw_capacity": 1048576, "conditional_process": false}}).to_string();
+        };
+        if params.epoch != epoch() { return encode_error(id, "stale_backend", "backend generation changed"); }
+        let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis();
+        if now >= u128::from(params.deadline_ms) { return encode_error(id, "deadline_exceeded", "no effect started"); }
+        operation["id"] = serde_json::Value::String(id.clone());
+        let Ok(request) = serde_json::from_value::<Request>(operation) else {
+            return encode_error(id, "invalid_request", "invalid guarded operation");
+        };
+        let target = match &request.method {
+            Method::PaneSendText(p) => Some(p.pane_id.as_str()),
+            Method::PaneClose(p) => Some(p.pane_id.as_str()),
+            Method::PaneRead(p) => Some(p.pane_id.as_str()),
+            Method::PaneProcessInfo(p) => p.pane_id.as_deref(),
+            Method::TabRename(_) => params.pane_id.as_deref(),
+            Method::SessionSnapshot(_) | Method::WorkspaceCreate(_) | Method::TabCreate(_) => None,
+            _ => return encode_error(id, "unsupported", "operation is outside terminal guard protocol"),
+        };
+        if let Some(target) = target {
+            if params.pane_id.as_deref() != Some(target) { return encode_error(id, "invalid_request", "target mismatch"); }
+            let Some((ws, pane)) = self.parse_pane_id(target) else { return encode_error(id, "stale_terminal", "pane disappeared"); };
+            let actual = self.state.terminal_id_for_pane(ws, pane).and_then(|value| self.lookup_runtime_sender(ws, pane).map(|runtime| format!("{value}.{}", runtime.corral_generation())));
+            if actual.is_none() || actual != params.terminal_id { return encode_error(id, "stale_terminal", "PTY generation changed"); }
+            if let Method::TabRename(p) = &request.method {
+                let Some((tab_ws, tab_idx)) = self.parse_tab_id(&p.tab_id) else { return encode_error(id, "stale_terminal", "tab disappeared"); };
+                if tab_ws != ws || !self.state.workspaces[ws].tabs[tab_idx].panes.contains_key(&pane) {
+                    return encode_error(id, "stale_terminal", "pane moved to another tab");
+                }
+            }
+        } else if matches!(&request.method, Method::TabRename(_)) {
+            return encode_error(id, "invalid_request", "rename needs terminal guard");
+        }
+        // No await, internal-event drain, or second queue between guard and effect.
+        let snapshot = matches!(&request.method, Method::SessionSnapshot(_));
+        let response = self.handle_api_request_after_internal_events_drained(request);
+        if !snapshot { return response; }
+        let mut value: serde_json::Value = serde_json::from_str(&response).unwrap();
+        if let Some(panes) = value["result"]["snapshot"]["panes"].as_array_mut() {
+            for pane in panes {
+                let generation = pane["pane_id"].as_str().and_then(|id| self.parse_pane_id(id))
+                    .and_then(|(ws, pane)| self.lookup_runtime_sender(ws, pane))
+                    .map(|runtime| runtime.corral_generation().to_string());
+                pane["corral_pty_generation"] = serde_json::json!(generation);
+            }
+        }
+        value.to_string()
+    }
+}
