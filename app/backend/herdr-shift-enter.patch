     #[test]
+    fn ghostty_legacy_pane_encodes_shift_enter_as_cr() {
+        let (tx, _rx) = mpsc::channel(4);
+        let terminal = crate::ghostty::Terminal::new(80, 24, 0).unwrap();
+        let pane = GhosttyPaneTerminal::new(terminal, tx).unwrap();
+        let shift_enter = crate::input::parse_terminal_key_sequence("\x1b[13;2u").unwrap();
+        let enter = crate::input::TerminalKey::new(
+            crossterm::event::KeyCode::Enter,
+            crossterm::event::KeyModifiers::empty(),
+        );
+
+        assert_eq!(
+            pane.keyboard_protocol(),
+            Some(crate::input::KeyboardProtocol::Legacy)
+        );
+        assert_eq!(pane.modify_other_keys_level(), 0);
+        assert_eq!(
+            pane.encode_terminal_key(shift_enter, crate::input::KeyboardProtocol::Legacy),
+            b"\r"
+        );
+        assert_eq!(
+            pane.encode_terminal_key(enter, crate::input::KeyboardProtocol::Legacy),
+            b"\r"
+        );
+    }
