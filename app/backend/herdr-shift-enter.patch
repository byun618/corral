+    #[test]
+    fn ghostty_legacy_pane_keeps_other_modified_enters() {
+        let (tx, _rx) = mpsc::channel(4);
+        let terminal = crate::ghostty::Terminal::new(80, 24, 0).unwrap();
+        let pane = GhosttyPaneTerminal::new(terminal, tx).unwrap();
+
+        for (sequence, expected) in [
+            ("\x1b[13;3u", b"\x1b\r".to_vec()),
+            ("\x1b[13;5u", b"\x1b[27;5;13~".to_vec()),
+        ] {
+            let key = crate::input::parse_terminal_key_sequence(sequence).unwrap();
+            assert_eq!(
+                pane.encode_terminal_key(key, crate::input::KeyboardProtocol::Legacy),
+                expected,
+                "{sequence:?}"
+            );
+        }
+    }
