{
  "name": "corral",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "corral — herdr 기반 AI 워크스페이스 미션 컨트롤 (LIFE-351 R1: 앱 골격 + 어댑터 control 층)",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && npm run build:runtime",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.mixed.json",
    "lint": "eslint .",
    "test": "vitest run && node scripts/run-nodetest.mjs",
    "check:boundary": "node scripts/check-boundary.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "herdr:guard": "node scripts/build-dev-guard.mjs",
    "package:mac": "npm run build && node scripts/bundle-herdr.mjs && electron-builder --mac --arm64"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "happy-dom": "^20.11.8",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/xterm": "6.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "2.0.7",
    "string-width": "7.2.0",
    "ws": "^8.22.0"
  },
  "bin": {
    "corral": "cli/corral.mjs"
  }
}
