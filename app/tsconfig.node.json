{
  "include": ["electron.vite.config.ts", "eslint.config.mjs", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "scripts/**/*"],
  // 벤더 테스트는 tsc 대상이 아니다 — bun:test 원본을 vitest 로 옮긴 것이라 corral 의
  // noUncheckedIndexedAccess 아래서 원본 그대로가 안 선다. 검증은 vitest 실행(S7ⓓ)이 한다.
  // 경과 시간 대조 프로브(수정 라운드 7)는 **렌더러의 순수 함수**를 일부러 import 한다 —
  // node 프로젝트에 렌더러를 끌어들이지 않으려고 여기서만 뺀다. 같은 대조가
  // `session-activity.test.ts` 에 박혀 있고 그쪽은 web 프로젝트가 타입 검사한다.
  "exclude": ["src/main/adapter/internal/vendor/*.test.ts", "scripts/l366/27-r7-elapsed.mts"],
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  }
}
