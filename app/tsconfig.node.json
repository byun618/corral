{
  "include": ["electron.vite.config.ts", "eslint.config.mjs", "src/runtime/**/*", "src/main/**/*", "src/shared/**/*", "scripts/**/*"],
  // 벤더 테스트는 tsc 대상이 아니다 — bun:test 원본을 vitest 로 옮긴 것이라 corral 의
  // noUncheckedIndexedAccess 아래서 원본 그대로가 안 선다. 검증은 vitest 실행(S7ⓓ)이 한다.
  // 창 없는 작업 화면 통합 시험(tasks-windowless)은 렌더러와 main 을 함께 import 해 mixed 검사(tsconfig.mixed.json)가 맡는다.
  "exclude": ["src/main/adapter/internal/vendor/*.test.ts", "scripts/tasks-windowless/*.test.tsx"],
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  }
}
