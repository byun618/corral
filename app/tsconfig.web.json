{
  "include": ["src/renderer/src/**/*", "src/shared/**/*"],
  // LIFE-601 R1-B — 실제 WorkService(main)를 렌더러 화면에 잇는 통합 시험은 두 층을 함께 import 해 이 프로젝트에 둘 수 없다(vitest 로만 돈다).
  "exclude": ["src/renderer/src/components/TasksPage.service.test.tsx"],
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  }
}
