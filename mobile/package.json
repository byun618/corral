{
  "name": "corral-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "doctor": "expo-doctor",
    "build:dev": "eas build -p android --profile development",
    "build:preview": "eas build -p android --profile preview",
    "build:prod": "eas build -p android --profile production",
    "build:local:dev": "eas build -p android --profile development --local",
    "build:local:preview": "eas build -p android --profile preview --local",
    "build:local:prod": "eas build -p android --profile production --local",
    "apk:install": "adb install -r $(ls -t build-*.apk | head -1)",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-community/netinfo": "11.4.1",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.34",
    "expo-application": "~7.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "happy-dom": "^20.14.6",
    "react-dom": "^19.1.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.7",
    "ws": "^8.22.0"
  }
}
